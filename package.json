{
  "name": "chinatravel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode singlefile",
    "validate": "node --experimental-strip-types src/data/validate.ts",
    "icons": "node scripts/make-icons.mjs",
    "shots": "node scripts/shots.mjs",
    "lint": "oxlint",
    "preview": "vite preview --port 4173"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.4",
    "zod": "^4.6.7"
  }
}
